# Kino Light build config. Copiá este archivo a `.env` en la raíz del repo y completá los valores.
#
#     cp .env.example .env
#
# `app/build.gradle.kts` lo lee con el helper `readEnv()` y mete los valores en BuildConfig.
# El `.env` está gitignoreado y NUNCA estuvo en git: no lo commitees.
#
# Nota: algunas fuentes de contenido necesitan configuración privada que no viaja en este
# repositorio público. Sin ella el build NO falla: sale un APK que compila e instala, pero
# con esas fuentes deshabilitadas. El fallo es silencioso, así que revisá los valores.

# --- TMDB ---
# Catálogo de películas/series en español (api_key v3, no el token v4).
# Gratis en https://www.themoviedb.org/settings/api
API_KEY=

# --- Chromecast (opcional) ---
# App ID del receptor propio, registrado por cuenta en la Cast Developer Console. Vacío = se usa el
# Default Media Receiver de Google, que reproduce menos formatos. Ver `receiver/index.html`.
CAST_RECEIVER_ID=

# --- Firma del APK de release (opcional) ---
# Solo hace falta para `./gradlew :app:assembleRelease`. Si están vacías, el APK sale SIN FIRMAR
# a propósito (no cae a la llave de debug) y no se puede instalar.
#
# Para crear tu propia llave:
#   keytool -genkeypair -v -keystore ~/.android/arkiv-release.jks -alias arkiv \
#     -keyalg RSA -keysize 4096 -validity 10950
#
# Guardá ese .jks en un lugar seguro: si lo perdés, Android no deja actualizar por encima
# ningún APK que hayas firmado con él.
RELEASE_KEYSTORE_PATH=
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=

# --- Version override (optional, used by the release CI pipeline) ---
# Only needed to test a local `assembleRelease` with a specific version.
# Left empty, the build falls back to the versionCode/versionName hardcoded
# in app/build.gradle.kts.
VERSION_CODE=
VERSION_NAME=
