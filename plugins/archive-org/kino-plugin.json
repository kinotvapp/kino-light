{
  "id": "archive-org",
  "name": "Internet Archive",
  "version": "1.3.0",
  "apiVersion": 4,
  "entry": "plugin.js",
  "description": "Películas de dominio público y televisión clásica de archive.org",
  "author": "kinotvapp",
  "homepage": "https://github.com/kinotvapp/kino-plugin-archive",
  "hosts": [
    "archive.org",
    "*.archive.org"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "color": "#E0A030",
  "icon": "icon.png",
  "settings": [
    {
      "key": "sources",
      "label": "Direcciones",
      "type": "list",
      "max": 30,
      "fields": [
        {
          "key": "url",
          "label": "Dirección",
          "type": "url",
          "required": true,
          "hint": "https://archive.org/details/… o una búsqueda"
        },
        {
          "key": "category",
          "label": "Categoría",
          "type": "text",
          "hint": "Opcional: nombre de la fila en el Home"
        }
      ]
    }
  ]
}
