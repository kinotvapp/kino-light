<?xml version="1.0" encoding="utf-8"?>
<!--
  Kino's app mark: the "o" of the kino TV wordmark (white ring + red dot), on its own.

  Same proportions as the "o" in docs/brand/kino-tv-logo.svg (ring centerline 80, stroke 35, dot
  30.5), scaled so the ring's outer edge sits at radius 30, inside the 66dp safe zone of the
  108dp adaptive canvas. ArkivSplash starts from this exact ring (54,54 at radius 30 of 108 is what
  the system splash paints at 80dp), so change both together.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M54,29.385 a24.615,24.615 0 1,1 0,49.23 a24.615,24.615 0 1,1 0,-49.23 Z"
        android:strokeWidth="10.769"
        android:strokeColor="#FFFFFF" />
    <path
        android:fillColor="@color/kino_logo_red"
        android:pathData="M54,44.615 a9.385,9.385 0 1,1 0,18.77 a9.385,9.385 0 1,1 0,-18.77 Z" />
</vector>
