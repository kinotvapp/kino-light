<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kino" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kino_background</item>
        <item name="android:statusBarColor">@color/kino_background</item>
        <item name="android:navigationBarColor">@color/kino_background</item>
        <item name="android:colorPrimary">@color/kino_red</item>
        <item name="android:colorAccent">@color/kino_red</item>
    </style>

    <!--
      Startup theme: the system paints the logo's ring over the brand background from the very
      first frame, then hands over to Theme.Kino, where the Compose intro continues the sequence.
    -->
    <style name="Theme.Kino.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kino_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Kino</item>
    </style>
</resources>
