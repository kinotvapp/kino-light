<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only additions. Nothing here reaches a release APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Triggered by hand over adb; see CaracolOfflineProbe's KDoc. -->
        <receiver
            android:name="com.arkiv.player.debug.CaracolOfflineProbe"
            android:exported="true" />

        <!-- Second question: does the shipping path work, queue and strategy included? -->
        <receiver
            android:name="com.arkiv.player.debug.CaracolDownloadProbe"
            android:exported="true" />

        <!-- Does the QuickJS native library load on this device? See QuickJsProbe. -->
        <receiver
            android:name="com.arkiv.player.debug.QuickJsProbe"
            android:exported="true" />
        <!-- Installs a plugin from the app's files dir through the real install flow; see PluginSideloadProbe. -->
        <receiver
            android:name="com.arkiv.player.debug.PluginSideloadProbe"
            android:exported="true" />
        <!-- Fires a fake HostApprovalCenter request to exercise the reactive dialog; see HostApprovalProbe. -->
        <receiver
            android:name="com.arkiv.player.debug.HostApprovalProbe"
            android:exported="true" />
        <!-- Plays one URL with the plugin player's ExoPlayer setup and logs the decoder's view; see StreamProbeActivity. -->
        <activity
            android:name="com.arkiv.player.debug.StreamProbeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
    </application>
</manifest>
